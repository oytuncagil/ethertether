# Every text file is stored and checked out with LF line endings.
* text=auto eol=lf

# Windows scripts keep CRLF so cmd.exe runs them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.zip binary
