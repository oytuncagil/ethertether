    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_access">Privileged access</string>
    <string name="settings_backend_only_shizuku">This version uses Shizuku, started with wireless debugging or ADB.</string>
    <string name="settings_automation">Automatic start</string>
    <string name="settings_keep_armed">Keep armed</string>
    <string name="settings_keep_armed_summary">Removing the adapter ends Ethernet tethering. With this on, EtherTether asks again right away, so the next adapter you plug in is served by itself.</string>
    <string name="settings_boot">Start after restart</string>
    <string name="settings_boot_summary">After the phone restarts, EtherTether waits up to five minutes for Shizuku, then arms the selected profile.</string>
    <string name="settings_automation_limits">Android allows this only while EtherTether shows its notification. While armed, every Ethernet adapter is used for tethering, so the phone cannot use a wired network itself. Shizuku must run: after a restart, start it again (Shizuku 13.6 and later can start by itself on Android 13 and later on a trusted Wi-Fi network).</string>
    <string name="settings_vendor_hint">On Xiaomi, Redmi and POCO phones, allow Autostart and set Battery saver to No restrictions for EtherTether and for Shizuku, or the system may stop them.</string>
    <string name="settings_unused_hint">Android can remove EtherTether\'s permissions when the app is not opened for a few months, and then the automatic start stops working. Turn this off for EtherTether.</string>
